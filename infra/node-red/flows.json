    {
        "id": "06e1f8233c78714f",
        "type": "function",
        "z": "edccd58e163e9dde",
        "name": "function 1",
        "func": "// 1. Obtener el historial acumulado en el contexto del flujo (si está vacío, inicia limpio)\nlet historial = flow.get(\"historial_consola\") || \"\";\n\n// 2. Extraer las variables del objeto JSON que viene de Wokwi\nlet datos = msg.payload;\nlet estadoAlarma = datos.alarma ? \"ACTIVA \" : \"INACTIVA \";\n\n// 3. Construir el bloque de texto con la nueva línea de Calidad de Aire\nlet nuevoBloque = `<div style=\"font-family: monospace; font-size: 12px; color: #f4ececff; line-height: 1.4;\">` +\n                  `====================================<br>` +\n                  `<b>Contador:</b> [${datos.contador}]<br>` +\n                  `   <b>Gas:</b> ${datos.gas_ppm} ppm<br>` +\n                  `   <b>Aire:</b> ${datos.aire_ppm} ppm<br>` +\n                  `<b>Calidad de Aire:</b> ${datos.calidad_aire}<br>` +\n                  ` <b>Alarma de Gas:</b> ${estadoAlarma}<br>` +\n                  `====================================</div><br>`;\n\n// 4. Agregar el nuevo bloque al inicio del historial para que lo más nuevo aparezca arriba\nhistorial = nuevoBloque + historial;\n\n// 5. Opcional: Limitar el historial a las últimas 15 mediciones para no saturar el celular\nlet lineas = historial.split(\"<br><br>\");\nif (lineas.length > 15) {\n    historial = lineas.slice(0, 15).join(\"<br><br>\");\n}\n\n// 6. Guardar el nuevo historial en la memoria del flujo\nflow.set(\"historial_consola\", historial);\n\n// 7. Enviar el bloque completo de texto acumulado hacia el Dashboard\nmsg.payload = historial;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 300,
        "wires": [
